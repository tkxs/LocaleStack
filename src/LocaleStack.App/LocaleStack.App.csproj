<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>LocaleStack</AssemblyName>
    <Product>译栈 LocaleStack</Product>
    <Description>游戏汉化安装与更新管理器</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LocaleStack.Core/LocaleStack.Core.csproj" />
    <Content Include="../../catalog/catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../../catalog/catalog.json" Link="Resources/catalog.json" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
