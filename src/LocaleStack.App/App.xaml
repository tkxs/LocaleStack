<Application x:Class="LocaleStack.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0D1219" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#121A24" />
    <SolidColorBrush x:Key="CardBrush" Color="#17212D" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#202D3B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#344355" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F4F8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A8B8C9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8CE8BD" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0A2D22" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#526273" CornerRadius="3" Margin="3,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0F1822"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionBrush" Value="#39795F"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,8"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource RaisedBrush}"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#0F1822"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,8,27,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" Foreground="#A8B8C9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        </Grid></Border>
        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Item" Property="Background" Value="#1A302D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#8EA599"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/></Style>
    <DrawingBrush x:Key="SpaceArtwork" Stretch="UniformToFill">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#15272D" Geometry="M0,0 H600 V240 H0Z"/>
        <GeometryDrawing Brush="#1D3F42" Geometry="M340,0 H600 V240 H420 C320,200 290,100 340,0"/>
        <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#43645D" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><EllipseGeometry Center="445,108" RadiusX="113" RadiusY="113"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#304E49" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><EllipseGeometry Center="445,108" RadiusX="143" RadiusY="143"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#6AAE94"><GeometryDrawing.Geometry><EllipseGeometry Center="445,108" RadiusX="66" RadiusY="66"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#24483F"><GeometryDrawing.Geometry><EllipseGeometry Center="465,90" RadiusX="59" RadiusY="59"/></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#C3E5D6" Geometry="M80,58 H82 V60 H80Z M175,36 H177 V38 H175Z M278,90 H280 V92 H278Z M230,190 H232 V192 H230Z M120,165 H122 V167 H120Z M545,192 H547 V194 H545Z M560,40 H562 V42 H560Z"/>
        <GeometryDrawing Brush="#D9EFE6" Geometry="M267,126 L292,118 L283,145 L279,133 Z"/>
        <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#8CE8BD" Thickness="1.2"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M267,145 L240,170 M261,154 L247,168"/></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
  </Application.Resources>
</Application>
