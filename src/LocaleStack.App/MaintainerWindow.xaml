<Window x:Class="LocaleStack.App.MaintainerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="译栈 · 维护者工作台" Width="1360" Height="980" MinWidth="1120" MinHeight="760" Background="{StaticResource BackgroundBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,12,0,7"/></Style>
    <Style x:Key="Editor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="#E6AD78"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202D3B"/><Setter Property="Foreground" Value="#BCCBD9"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="MinHeight" Value="34"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#17212D"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#275443"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Border Background="{StaticResource BackgroundBrush}" Padding="28,22,28,20"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="LOCALESTACK / PUBLISH" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11"/><TextBlock Text="把你的汉化，交到玩家手中。" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,8"/><TextBlock Text="选目录、打包、发布。上传成功后，游戏目录自动更新。" Style="{StaticResource Muted}"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,0,0,10"/><Button Content="载入已有补丁 / 继续发布" Command="{Binding LoadPackageCommand}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="500"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0" IsEnabled="{Binding CanEdit}">
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="01   游戏与汉化版本" Style="{StaticResource SectionTitle}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="游戏 ID（固定的小写标识）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding GameId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource Editor}" AutomationProperties.Name="游戏 ID"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="游戏名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding GameTitle, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource Editor}" AutomationProperties.Name="游戏名称"/></StackPanel>
          </Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="汉化版本（例如 1.0.1）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource Editor}" AutomationProperties.Name="汉化版本"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Steam App ID（可选）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Style="{StaticResource Editor}" AutomationProperties.Name="Steam App ID"/></StackPanel>
          </Grid>
          <TextBlock Text="本次更新说明" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="本次更新说明"/>
          <Expander Header="目录简介与进程设置（可选）" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"><StackPanel>
            <TextBlock Text="游戏目录简介" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="52" TextWrapping="Wrap" AutomationProperties.Name="目录简介"/>
            <TextBlock Text="进程文件名（留空时从原版推断，多个以分号分隔）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ExecutableNames, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="游戏进程文件名"/>
          </StackPanel></Expander>
        </StackPanel></Border>
        <Border Style="{StaticResource Panel}"><StackPanel>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="02   选择原版与汉化目录" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ 版本" Command="{Binding AddVariantCommand}" Padding="10,6" Margin="0,0,6,0"/><Button Content="移除" Command="{Binding RemoveVariantCommand}" Padding="10,6"/></StackPanel></Grid>
          <ListBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" MaxHeight="95" AutomationProperties.Name="兼容版本列表"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12" Margin="12,8"/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Text="干净原版 / 对应构建的英文备份" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedVariant.OriginalDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="原版目录"/><Button Grid.Column="1" Content="选择" Command="{Binding BrowseOriginalCommand}" Margin="8,0,0,0" Padding="13,8"/></Grid>
          <TextBlock Text="汉化目录 / Chinese_Patch 输出目录" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedVariant.TranslatedDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="汉化目录"/><Button Grid.Column="1" Content="选择" Command="{Binding BrowseTranslatedCommand}" Margin="8,0,0,0" Padding="13,8"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="游戏来源" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Storefronts}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedVariant.Storefront}" Padding="10,8" FontSize="12" AutomationProperties.Name="兼容版本的游戏来源"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Steam Build ID（可选）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedVariant.BuildIds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SelectedVariant.IsSteam}" AutomationProperties.Name="Steam Build ID"/></StackPanel>
          </Grid>
          <Expander Header="版本名称与额外指纹" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,0"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="版本 ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedVariant.Id, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="兼容版本 ID"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedVariant.Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="兼容版本显示名称"/></StackPanel></Grid>
            <TextBlock Text="额外原版指纹（相对路径，多个以分号分隔）" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedVariant.FingerprintFiles, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="额外原版指纹文件"/><Button Grid.Column="1" Content="添加" Command="{Binding BrowseFingerprintCommand}" Margin="8,0,0,0" Padding="13,8"/></Grid>
            <TextBlock Text="被替换的原版文件自动成为指纹。仅新增文件时，默认使用原版 exe；没有 exe 时需额外选择一个版本识别文件。" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel></Expander>
        </StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="将要打包的文件" Style="{StaticResource SectionTitle}"/>
          <TextBlock Grid.Row="1" Text="{Binding SelectionSummary}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,14"/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedFiles}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" RowHeaderWidth="0" Background="#17212D" BorderThickness="0" HorizontalGridLinesBrush="#2D3D4A" GridLinesVisibility="Horizontal" IsEnabled="{Binding CanEdit}" FontSize="11" MinHeight="95" AutomationProperties.Name="改动文件预览">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="包含此补丁文件"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="文件（当前兼容版本）" Binding="{Binding File.Path}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="类型" Binding="{Binding File.Change}" Width="52" IsReadOnly="True"/>
              <DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" Width="76" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="3" Text="默认勾选修改与新增文件。扫描后可取消不需要的内容；原版与汉化输入目录都只读。" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
        </Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}"><StackPanel>
          <TextBlock Text="03   发布到 GitHub" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{Binding AccountLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,12"/>
          <StackPanel IsEnabled="{Binding CanEdit}">
            <TextBlock Text="GitHub 访问令牌" FontSize="12" Margin="0,0,0,7"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="TokenBox" Background="#0F1822" Foreground="#F0F4F8" BorderBrush="#344355" Padding="10,9" AutomationProperties.Name="GitHub 访问令牌"/><Button Grid.Column="1" Content="连接" Click="ConnectClicked" Margin="8,0,0,0" Padding="16,8"/></Grid>
            <CheckBox x:Name="RememberCredential" IsChecked="True" Content="在此电脑记住令牌（Windows 凭据管理器）" FontSize="11"/>
            <WrapPanel><Button Content="创建访问令牌 ↗" Command="{Binding CreateTokenCommand}" Padding="9,6" Margin="0,0,6,6"/><Button Content="使用保存的连接" Command="{Binding UseSavedCredentialCommand}" Padding="9,6" Margin="0,0,6,6"/><Button Content="断开并忘记" Command="{Binding ForgetCredentialCommand}" Padding="9,6" Margin="0,0,0,6"/></WrapPanel>
            <TextBlock Text="令牌只需授权 tkxs/LocaleStack 仓库的 Contents: Read and write。无需安装 Git 或 .NET。" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
            <TextBlock Text="本地补丁输出目录" FontSize="12" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="补丁输出目录"/><Button Grid.Column="1" Content="选择" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" Padding="13,8"/></Grid>
          </StackPanel>
          <TextBlock Text="{Binding TagPreview}" Style="{StaticResource Muted}" FontSize="10" Margin="0,14,0,0"/>
        </StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#344355" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PackageLabel}" FontSize="12"/><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,20,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="打开输出" Command="{Binding OpenOutputCommand}" Margin="0,0,8,0" Padding="12,10"/><Button Content="查看发布页 ↗" Command="{Binding OpenResultCommand}" Margin="0,0,8,0" Padding="12,10"/><Button Content="取消" Command="{Binding CancelCommand}" Padding="12,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></WrapPanel></Grid>
      <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="5" Foreground="{StaticResource AccentBrush}" Background="#344355" BorderThickness="0" Margin="0,0,28,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="扫描 / 更新差异" Command="{Binding ScanCommand}" Margin="0,0,10,0"/><Button Content="仅生成本地补丁" Command="{Binding BuildCommand}" Margin="0,0,10,0"/><Button Content="{Binding PublishLabel}" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170"/></StackPanel></Grid>
    </Grid></Border>
  </Grid></Border>
</Window>
