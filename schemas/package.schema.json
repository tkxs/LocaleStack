{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tkxs/LocaleStack/main/schemas/package.schema.json",
  "title": "LocaleStack Patch Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "gameTitle", "version", "variants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": { "$ref": "#/$defs/id" },
    "gameTitle": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/version" },
    "language": { "const": "zh-CN", "default": "zh-CN" },
    "steamAppId": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
    "executableNames": { "type": "array", "items": { "type": "string", "pattern": "^[^/\\\\]+\\.[eE][xX][eE]$" }, "uniqueItems": true },
    "variants": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/variant" } }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 220, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[<>:\"|?*])(?!.*//)(?!\\.localestack(?:/|$))[^\\u0000-\\u001f]+$", "description": "Normalized relative path. Runtime additionally rejects Windows reserved names, trailing dots/spaces, links, and case-insensitive collisions." },
    "fingerprint": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "payload", "sha256", "originalSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "payload": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "^payload/" }] },
        "sha256": { "$ref": "#/$defs/hash" },
        "originalSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }], "description": "null requires the target to be absent in the clean game." }
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "storefront", "fingerprints", "files"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "storefront": { "enum": ["any", "steam", "standalone"], "default": "any" },
        "steamBuildIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+$" } },
        "fingerprints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" } },
        "files": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/file" } }
      },
      "allOf": [{ "if": { "properties": { "storefront": { "enum": ["any", "standalone"] } } }, "then": { "properties": { "steamBuildIds": { "maxItems": 0 } } } }]
    }
  }
}
